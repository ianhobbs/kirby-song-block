{
    "name": "ianhobbs/song-block",
    "description": "A song block for Kirby CMS: audio player with poster image (beside the text or as background), title, subtitle, description and colours",
    "type": "kirby-plugin",
    "license": "MIT",
    "homepage": "https://github.com/ianhobbs/kirby-song-block",
    "keywords": [
        "kirby",
        "kirby-plugin",
        "kirby-cms",
        "audio",
        "block",
        "music"
    ],
    "authors": [
        {
            "name": "Ian Hobbs",
            "email": "ian@ianhobbs.net"
        }
    ],
    "support": {
        "issues": "https://github.com/ianhobbs/kirby-song-block/issues",
        "source": "https://github.com/ianhobbs/kirby-song-block"
    },
    "require": {
        "php": ">=8.1",
        "getkirby/composer-installer": "^1.2"
    },
    "conflict": {
        "getkirby/cms": "<4.0.0 || >=6.0.0"
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "getkirby/composer-installer": true
        }
    }
}
